<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A birthday reminder is a notification; on Android 13 and later that is granted at runtime, when
         reminders are turned on from the Birthdays page. Nothing is asked for at install time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 11 and later hide one app from another unless the first names it, and a hidden app
         cannot be reached at all - not its package, not its provider. This names the journal, so the
         birthdays kept there can be read the same way UJournal reads these. Only that one provider is
         named, and it is read-only. -->
    <queries>
        <package android:name="app.ujournal" />
        <provider android:authorities="app.ujournal.birthdays" />
    </queries>
    <application android:label="Family Tree" android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.App" android:allowBackup="true" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A picture taken with the camera is written into the app's own files, so the camera app is
             handed a one-off writable URI through this provider: no camera and no storage permission
             is needed for that. No CAMERA permission is declared on purpose - declaring it would make
             the camera intent need a runtime grant. -->
        <!-- The birthdays, for the journal beside this app: read-only, and only the list the
             reminder job already keeps. Exported because UJournal is a separate app under its own
             signature; no write can reach it. -->
        <provider
            android:name=".BirthdayProvider"
            android:authorities="${applicationId}.birthdays"
            android:exported="true" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
