<?xml version="1.0" encoding="utf-8"?>
<!-- The one folder the camera app is allowed to write a taken picture into: the app's own private
     files, under shots/. Files does not see it, nothing else can reach it, and it is the same folder
     the page reads the picture back from. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="shots" path="shots/" />
</paths>
